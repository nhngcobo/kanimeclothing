@using kanimeclothing.Services
@using kanimeclothing.Models
@inject ILocalizationService Localizer
@model Cart

@{
    ViewData["Title"] = "Shopping Cart";
}

<link rel="stylesheet" href="~/css/cart.css" />

<div class="cart-container">
    <div class="cart-back-link">
        <a href="@Url.Action("Shop", "Home")" class="back-link">← @Localizer["BackToShop"]</a>
    </div>

    <h1 class="cart-title">Shopping Cart</h1>

    @if (Model != null && Model.Items.Count > 0)
    {
        <div class="cart-wrapper">
            <div class="cart-items-section">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Size</th>
                            <th>Color</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="product-cell">
                                    <div class="product-info">
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="cart-item-image">
                                        <span>@item.ProductName</span>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrEmpty(item.Size) ? "-" : item.Size)</td>
                                <td>@(string.IsNullOrEmpty(item.Color) ? "-" : item.Color)</td>
                                <td>R@(item.Price.ToString("F2"))</td>
                                <td>
                                    <form method="post" action="@Url.Action("UpdateCart")" class="quantity-form">
                                        <input type="hidden" name="productId" value="@item.ProductId">
                                        <input type="hidden" name="size" value="@item.Size">
                                        <input type="hidden" name="color" value="@item.Color">
                                        <div class="quantity-control">
                                            <button type="button" class="qty-btn" onclick="decreaseQty(this)">-</button>
                                            <input type="number" name="quantity" class="qty-input" value="@item.Quantity" min="1">
                                            <button type="button" class="qty-btn" onclick="increaseQty(this)">+</button>
                                        </div>
                                    </form>
                                </td>
                                <td>R@(item.Total.ToString("F2"))</td>
                                <td>
                                    <form method="post" action="@Url.Action("RemoveFromCart")" style="display: inline;">
                                        <input type="hidden" name="productId" value="@item.ProductId">
                                        <input type="hidden" name="size" value="@item.Size">
                                        <input type="hidden" name="color" value="@item.Color">
                                        <button type="submit" class="remove-btn">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cart-summary-section">
                <div class="cart-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span>R@(Model.Total.ToString("F2"))</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping:</span>
                        <span>R0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Tax:</span>
                        <span>R0.00</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total:</span>
                        <span>R@(Model.Total.ToString("F2"))</span>
                    </div>
                    <button class="checkout-btn" onclick="proceedToCheckout()">Proceed to Checkout</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <p>Your cart is empty.</p>
            <a href="@Url.Action("Shop", "Home")" class="continue-shopping-btn">Continue Shopping</a>
        </div>
    }
</div>

<script>
function decreaseQty(btn) {
    const input = btn.parentElement.querySelector('.qty-input');
    if (input.value > 1) {
        input.value = parseInt(input.value) - 1;
        submitForm(btn);
    }
}

function increaseQty(btn) {
    const input = btn.parentElement.querySelector('.qty-input');
    input.value = parseInt(input.value) + 1;
    submitForm(btn);
}

function submitForm(btn) {
    btn.closest('form').submit();
}

function proceedToCheckout() {
    // Display a confirmation message with order summary
    const cartTotal = document.querySelector('.summary-row.total span:last-child').textContent;
    const isConfirmed = confirm(`Your order total is ${cartTotal}. Do you want to proceed to payment?`);
    
    if (isConfirmed) {
        // Show loading indicator
        showLoadingMessage('Processing your payment...');
        
        // Redirect to Paystack payment gateway with return URL
        const returnUrl = window.location.origin + '@Url.Action("PaymentCallback", "Home")';
        const paystackUrl = 'https://paystack.shop/pay/riubdydr0t?redirect_url=' + encodeURIComponent(returnUrl);
        
        // Redirect to Paystack
        window.location.href = paystackUrl;
    }
}

function showLoadingMessage(message) {
    const loader = document.createElement('div');
    loader.id = 'loading-overlay';
    loader.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    `;
    
    const content = document.createElement('div');
    content.style.cssText = `
        background: white;
        padding: 2rem;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    `;
    
    content.innerHTML = `
        <div style="font-size: 2rem; margin-bottom: 1rem;">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <p style="margin: 0; color: #333;">${message}</p>
        <p style="margin: 0.5rem 0 0 0; color: #999; font-size: 0.9rem;">Redirecting to payment gateway...</p>
    `;
    
    loader.appendChild(content);
    document.body.appendChild(loader);
}
</script>
