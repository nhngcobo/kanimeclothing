<div id="checkout-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <h2 class="modal-title">CONFIRM CHECKOUT</h2>
        <p class="modal-message">Are you ready to proceed to payment?</p>
        <div class="modal-buttons">
            <button type="button" class="modal-btn modal-btn-cancel" onclick="document.getElementById('checkout-modal').style.display='none'">Cancel</button>
            <button type="button" class="modal-btn modal-btn-proceed" onclick="redirectToPayment()">Proceed to Payment</button>
        </div>
    </div>
</div>
