@using kanimeclothing.Services
@inject ILocalizationService Localizer

@{
    ViewData["Title"] = "Home Page";
}

<div class="homepage-slideshow">
    <div class="slideshow-container">
        <div class="slide fade">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999060/HomepageSlide1_b0og5z.jpg" alt="Slide 1">
        </div>
        <div class="slide fade">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999084/HomepageSlide2_fkhngq.jpg" alt="Slide 2">
        </div>
        <div class="slide fade">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999058/HomepageSlide3_ykk2kq.jpg" alt="Slide 3">
        </div>
        <div class="slide fade">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999073/HomepageSlide4_zomlie.jpg" alt="Slide 4">
        </div>

        <div class="slide-overlay">
            <p class="slide-text">@Localizer["HomeSlideMessage"]</p>
        </div>

        <div class="dots-container">
            <span class="dot" onclick="currentSlide(0)"></span>
            <span class="dot" onclick="currentSlide(1)"></span>
            <span class="dot" onclick="currentSlide(2)"></span>
            <span class="dot" onclick="currentSlide(3)"></span>

        </div>
    </div>
</div>

<script>
    let slideIndex = 0;
    let autoSlideTimer = null;

    function currentSlide(n) {
        let slides = document.getElementsByClassName("slide");
        let dots = document.getElementsByClassName("dot");

        for (let i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
            slides[i].classList.remove("active");
        }

        for (let i = 0; i < dots.length; i++) {
            dots[i].classList.remove("active");
        }

        slides[n].style.display = "block";
        slides[n].classList.add("active");
        dots[n].classList.add("active");
        slideIndex = n;

        // Reset the auto-slide timer when manually changing slides
        stopAutoSlide();
        startAutoSlide();
    }

    function nextSlide() {
        let slides = document.getElementsByClassName("slide");
        let next = (slideIndex + 1) % slides.length;
        currentSlide(next);
    }

    function startAutoSlide() {
        autoSlideTimer = setInterval(nextSlide, 5000);
    }

    function stopAutoSlide() {
        if (autoSlideTimer) {
            clearInterval(autoSlideTimer);
            autoSlideTimer = null;
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        currentSlide(0);
        
        let slideshowContainer = document.querySelector(".slideshow-container");
        
        slideshowContainer.addEventListener("mouseenter", function() {
            stopAutoSlide();
        });

        slideshowContainer.addEventListener("mouseleave", function() {
            startAutoSlide();
        });

        startAutoSlide();
    });
</script>
