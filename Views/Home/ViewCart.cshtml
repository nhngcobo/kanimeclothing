@using kanimeclothing.Services
@using kanimeclothing.Models
@inject ILocalizationService Localizer
@model Cart

@{
    ViewData["Title"] = "Shopping Cart";
}

<link rel="stylesheet" href="~/css/cart.css" />

<div class="cart-container">
    <div class="cart-back-link">
        <a href="@Url.Action("Shop", "Home")" class="back-link">← @Localizer["BackToShop"]</a>
    </div>

    <h1 class="cart-title">Shopping Cart</h1>

    @await Html.PartialAsync("_CheckoutConfirmationModal")

    @if (Model != null && Model.Items.Count > 0)
    {
        <div class="cart-wrapper">
            <div class="cart-items-section">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Size</th>
                            <th>Color</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="product-cell">
                                    <div class="product-info">
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="cart-item-image">
                                        <span>@item.ProductName</span>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrEmpty(item.Size) ? "-" : item.Size)</td>
                                <td>@(string.IsNullOrEmpty(item.Color) ? "-" : item.Color)</td>
                                <td>R@(item.Price.ToString("F2"))</td>
                                <td>
                                    <form method="post" action="@Url.Action("UpdateCart")" class="quantity-form">
                                        <input type="hidden" name="productId" value="@item.ProductId">
                                        <input type="hidden" name="size" value="@item.Size">
                                        <input type="hidden" name="color" value="@item.Color">
                                        <div class="quantity-control">
                                            <button type="button" class="qty-btn" onclick="decreaseQty(this)">-</button>
                                            <input type="number" name="quantity" class="qty-input" value="@item.Quantity" min="1">
                                            <button type="button" class="qty-btn" onclick="increaseQty(this)">+</button>
                                        </div>
                                    </form>
                                </td>
                                <td>R@(item.Total.ToString("F2"))</td>
                                <td>
                                    <form method="post" action="@Url.Action("RemoveFromCart")" style="display: inline;">
                                        <input type="hidden" name="productId" value="@item.ProductId">
                                        <input type="hidden" name="size" value="@item.Size">
                                        <input type="hidden" name="color" value="@item.Color">
                                        <button type="submit" class="remove-btn">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cart-summary-section">
                <div class="cart-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span>R@(Model.Total.ToString("F2"))</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping:</span>
                        <span>R0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Tax:</span>
                        <span>R0.00</span>
                    </div>
                    <div class="summary-row total">
                        <span>Total:</span>
                        <span>R@(Model.Total.ToString("F2"))</span>
                    </div>
                    <button class="checkout-btn" onclick="proceedToCheckout()">Proceed to Checkout</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <p>Your cart is empty.</p>
            <a href="@Url.Action("Shop", "Home")" class="continue-shopping-btn">Continue Shopping</a>
        </div>
    }
</div>

<script>
function decreaseQty(btn) {
    adjustQty(btn, -1);
}

function increaseQty(btn) {
    adjustQty(btn, 1);
}

function adjustQty(btn, delta) {
    const input = btn.parentElement.querySelector('.qty-input');
    let quantity = parseInt(input.value, 10) || 1;
    quantity = Math.max(1, quantity + delta);
    input.value = quantity;
    updateRowTotal(btn.closest('tr'));
    updateCartSummary();
}

function updateRowTotal(row) {
    if (!row) return;
    const priceText = row.querySelector('td:nth-child(4)').textContent.trim().replace('R', '');
    const quantity = parseInt(row.querySelector('.qty-input').value, 10) || 1;
    const rowTotalCell = row.querySelector('td:nth-child(6)');
    const price = parseFloat(priceText.replace(',', '')) || 0;
    rowTotalCell.textContent = 'R' + (price * quantity).toFixed(2);
}

function updateCartSummary() {
    const rows = document.querySelectorAll('.cart-table tbody tr');
    let subtotal = 0;
    rows.forEach(row => {
        const rowTotalText = row.querySelector('td:nth-child(6)').textContent.trim().replace('R', '');
        subtotal += parseFloat(rowTotalText.replace(',', '')) || 0;
    });

    const subtotalElem = document.querySelector('.summary-row:nth-child(1) span:last-child');
    const totalElem = document.querySelector('.summary-row.total span:last-child');

    if (subtotalElem) subtotalElem.textContent = 'R' + subtotal.toFixed(2);
    if (totalElem) totalElem.textContent = 'R' + subtotal.toFixed(2);
}

async function proceedToCheckout() {
    await syncCartQuantitiesToServer();
    openCheckoutModal();
}

async function syncCartQuantitiesToServer() {
    const rows = document.querySelectorAll('.cart-items-section tbody tr');
    const url = '@Url.Action("UpdateCart", "Home")';

    for (const row of rows) {
        const form = row.querySelector('form.quantity-form');
        if (!form) continue;

        const productId = form.querySelector('input[name="productId"]').value;
        const size = form.querySelector('input[name="size"]').value;
        const color = form.querySelector('input[name="color"]').value;
        const quantity = form.querySelector('input[name="quantity"]').value;

        const data = new URLSearchParams();
        data.append('productId', productId);
        data.append('size', size);
        data.append('color', color);
        data.append('quantity', quantity);

        await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: data.toString()
        });
    }
}

function openCheckoutModal() {
    const modal = document.getElementById('checkout-modal');
    if (modal) {
        modal.style.display = 'flex';
    }
}

function redirectToPayment() {
    const returnUrl = window.location.origin + '@Url.Action("PaymentCallback", "Home")';
    const paystackUrl = 'https://paystack.shop/pay/riubdydr0t?redirect_url=' + encodeURIComponent(returnUrl);
    window.location.href = paystackUrl;
}

// Close modal when clicking outside of modal content
const checkoutModal = document.getElementById('checkout-modal');
if (checkoutModal) {
    checkoutModal.addEventListener('click', function(e) {
        if (e.target === this) {
            e.currentTarget.style.display = 'none';
        }
    });
}
</script>
