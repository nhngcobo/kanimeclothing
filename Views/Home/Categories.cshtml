@using kanimeclothing.Services
@inject ILocalizationService Localizer

@{
    ViewData["Title"] = "Categories";
}

<div class="categories-container">
    <h1 class="categories-title">@Localizer["CategoriesTitle"].ToUpper()</h1>
    <div class="categories-grid">
        <div class="category-card">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999062/MensCategory_kp96we.jpg" alt="Men's Collection" class="category-image">
            <div class="category-overlay">
                <h2 class="category-title">@Localizer["MensCategory"]</h2>
                    <a class="category-btn" asp-area="" asp-controller="Home" asp-action="Shop">@Localizer["ShopNow"]</a>
            </div>
        </div>

        <div class="category-card">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999061/WomensCategory_b25wff.jpg" alt="Women's Collection" class="category-image">
            <div class="category-overlay">
                <h2 class="category-title">@Localizer["WomensCategory"]</h2>
                <a class="category-btn" asp-area="" asp-controller="Home" asp-action="Shop">@Localizer["ShopNow"]</a>
            </div>
        </div>

        <div class="category-card">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999059/KidsCategory_ydwjfx.jpg" alt="Kids Collection" class="category-image">
            <div class="category-overlay">
                <h2 class="category-title">@Localizer["KidsCategory"]</h2>
                <a class="category-btn" asp-area="" asp-controller="Home" asp-action="Shop">@Localizer["ShopNow"]</a>
            </div>
        </div>

        <div class="category-card">
            <img src="https://res.cloudinary.com/ddpphpv81/image/upload/v1773999059/AccessoryCategory_e747zm.jpg" alt="Accessory Collection" class="category-image">
            <div class="category-overlay">
                <h2 class="category-title">@Localizer["AccessoriesCategory"]</h2>
                <a class="category-btn" asp-area="" asp-controller="Home" asp-action="Shop">@Localizer["ShopNow"]</a>
            </div>
        </div>
    </div>
</div>
