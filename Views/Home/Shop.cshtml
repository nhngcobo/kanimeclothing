@using kanimeclothing.Services
@using kanimeclothing.Models
@inject ILocalizationService Localizer
@model List<Product>

@{
    ViewData["Title"] = "Shop";
}

<div class="shop-container">
    <h1 class="shop-title">@Localizer["OurShop"]</h1>

    <div class="shop-filters">
        <div class="filter-buttons">
            <button type="button" class="filter-btn filter-category-btn active" data-category="all" title="View all products">@Localizer["All"]</button>
            <button type="button" class="filter-btn filter-category-btn" data-category="Men" title="Filter by Men">@Localizer["Men"]</button>
            <button type="button" class="filter-btn filter-category-btn" data-category="Women" title="Filter by Women">@Localizer["Women"]</button>
            <button type="button" class="filter-btn filter-category-btn" data-category="Kids" title="Filter by Kids">@Localizer["Kids"]</button>
            <button type="button" class="filter-btn filter-category-btn" data-category="Accessories" title="Filter by Accessories">@Localizer["Accessories"]</button>
        </div>

        <div class="filter-dropdown">
            <select class="filter-select" id="priceSort">
                <option value="">@Localizer["TypesOfFilter"]</option>
                <option value="low-to-high">Price: Low to High</option>
                <option value="high-to-low">Price: High to Low</option>
                <option value="newest">Newest</option>
            </select>
        </div>
    </div>

    <div class="products-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <a asp-action="Details" asp-controller="Home" asp-route-id="@product.Id" class="product-card-link">
                    <div class="product-card" data-category="@product.Category" data-price="@product.Price" data-id="@product.Id">
                        <div class="product-image-container">
                            <img src="@product.Url" alt="@product.Name" class="product-image">
                            @if (product.Id == 1)
                            {
                                <div class="product-badge">SALE</div>
                            }
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">@product.Name</h3>
                            <p class="product-category">@product.Category</p>
                            <p class="product-price">R@(product.Price.ToString("F2"))</p>
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <p>No products available.</p>
        }
    </div>
</div>

<!-- JavaScript for filtering and sorting products, much easier than a AJAX call -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const categoryBtns = document.querySelectorAll('.filter-category-btn');
    const sortSelect = document.getElementById('priceSort');
    const grid = document.querySelector('.products-grid');
    const products = Array.from(document.querySelectorAll('.product-card'));

    function applyFilter() {
        const category = document.querySelector('.filter-category-btn.active').dataset.category;
        const sort = sortSelect.value;

        // Filter products
        let filtered = products.filter(p => 
            category === 'all' || p.dataset.category === category
        );

        // Sort products
        if (sort === 'low-to-high') {
            filtered.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
        } else if (sort === 'high-to-low') {
            filtered.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
        } else if (sort === 'newest') {
            filtered.sort((a, b) => parseInt(b.dataset.id) - parseInt(a.dataset.id));
        }

        // Show/hide and reorder
        products.forEach(p => p.parentElement.style.display = 'none');
        filtered.forEach(p => {
            p.parentElement.style.display = 'block';
            grid.appendChild(p.parentElement);
        });
    }

    categoryBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            categoryBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            applyFilter();
        });
    });

    sortSelect.addEventListener('change', applyFilter);
});
</script>
