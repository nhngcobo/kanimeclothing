@using kanimeclothing.Services
@using kanimeclothing.Models
@inject ILocalizationService Localizer
@model List<Product>

@{
    ViewData["Title"] = "Shop";
}

<div class="shop-container">
    <h1 class="shop-title">@Localizer["OurShop"]</h1>

    <div class="shop-filters">
        <div class="filter-buttons">
            <a asp-action="Shop" asp-route-category="all" asp-route-sort="@ViewBag.SelectedSort" class="filter-btn @(string.IsNullOrEmpty(ViewBag.SelectedCategory) ? "active" : "")">@Localizer["All"]</a>
            <a asp-action="Shop" asp-route-category="Men" asp-route-sort="@ViewBag.SelectedSort" class="filter-btn @(ViewBag.SelectedCategory == "Men" ? "active" : "")">@Localizer["Men"]</a>
            <a asp-action="Shop" asp-route-category="Women" asp-route-sort="@ViewBag.SelectedSort" class="filter-btn @(ViewBag.SelectedCategory == "Women" ? "active" : "")">@Localizer["Women"]</a>
            <a asp-action="Shop" asp-route-category="Kids" asp-route-sort="@ViewBag.SelectedSort" class="filter-btn @(ViewBag.SelectedCategory == "Kids" ? "active" : "")">@Localizer["Kids"]</a>
            <a asp-action="Shop" asp-route-category="Accessories" asp-route-sort="@ViewBag.SelectedSort" class="filter-btn @(ViewBag.SelectedCategory == "Accessories" ? "active" : "")">@Localizer["Accessories"]</a>
        </div>

        <div class="filter-dropdown">
            <select class="filter-select" id="priceSort" onchange="window.location.href = this.options[this.selectedIndex].value">
                <option value="@Url.Action("Shop", new { category = ViewBag.SelectedCategory })">@Localizer["TypesOfFilter"]</option>
                @if (ViewBag.SelectedSort == "low-to-high")
                {
                    <option value="@Url.Action("Shop", new { category = ViewBag.SelectedCategory, sort = "low-to-high" })" selected>Price: Low to High</option>
                }
                else
                {
                    <option value="@Url.Action("Shop", new { category = ViewBag.SelectedCategory, sort = "low-to-high" })">Price: Low to High</option>
                }
                @if (ViewBag.SelectedSort == "high-to-low")
                {
                    <option value="@Url.Action("Shop", new { category = ViewBag.SelectedCategory, sort = "high-to-low" })" selected>Price: High to Low</option>
                }
                else
                {
                    <option value="@Url.Action("Shop", new { category = ViewBag.SelectedCategory, sort = "high-to-low" })">Price: High to Low</option>
                }
                @if (ViewBag.SelectedSort == "newest")
                {
                    <option value="@Url.Action("Shop", new { category = ViewBag.SelectedCategory, sort = "newest" })" selected>Newest</option>
                }
                else
                {
                    <option value="@Url.Action("Shop", new { category = ViewBag.SelectedCategory, sort = "newest" })">Newest</option>
                }
            </select>
        </div>
    </div>

    <div class="products-grid">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <a asp-action="Details" asp-controller="Home" asp-route-id="@product.Id" class="product-card-link">
                    <div class="product-card" data-category="@product.Category" data-price="@product.Price" data-id="@product.Id">
                        <div class="product-image-container">
                            <img src="@product.Url" alt="@product.Name" class="product-image">
                            @if (product.Id == 1)
                            {
                                <div class="product-badge">SALE</div>
                            }
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">@product.Name</h3>
                            <p class="product-category">@product.Category</p>
                            <p class="product-price">R@(product.Price.ToString("F2"))</p>
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <p>No products available.</p>
        }
    </div>
</div>
