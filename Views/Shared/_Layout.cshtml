<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - kanimeclothing</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/kanimeclothing.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="navbar-nav me-auto">
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Index">HOME</a>
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Categories">CATEGORIES</a>
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Shop">SHOP</a>
                </div>

                <span class="navbar-text mx-auto fw-500 fs-5">KANIMECLOTHING</span>

                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-black fw-500" href="#" title="Search">
                        <i class="bi bi-search"></i>
                    </a>
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Contact" title="Contact">
                        CONTACT
                    </a>
                    <a class="nav-link text-black fw-500" href="#" title="User Account">
                        <i class="bi bi-person"></i>
                    </a>
                    <a class="nav-link text-black fw-500" href="#" title="Shopping Cart">
                        <i class="bi bi-bag"></i>
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - kanimeclothing - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
