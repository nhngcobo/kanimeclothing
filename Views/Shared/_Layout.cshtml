<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - kanimeclothing</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/kanimeclothing.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="navbar-nav me-auto">
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Index">HOME</a>
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Categories">CATEGORIES</a>
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Shop">SHOP</a>
                </div>

                <span class="navbar-text mx-auto fw-500 fs-5">KANIMECLOTHING</span>

                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-black fw-500" href="#" title="Search">
                        <i class="bi bi-search"></i>
                    </a>
                    <a class="nav-link text-black fw-500" asp-area="" asp-controller="Home" asp-action="Contact" title="Contact">
                        CONTACT
                    </a>
                    <a class="nav-link text-black fw-500" href="#" title="User Account">
                        <i class="bi bi-person"></i>
                    </a>
                    <a class="nav-link text-black fw-500 position-relative" asp-area="" asp-controller="Home" asp-action="ViewCart" title="Shopping Cart">
                        <i class="bi bi-bag"></i>
                        @if (ViewData["CartItemCount"] != null && (int?)ViewData["CartItemCount"] > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @ViewData["CartItemCount"]
                                <span class="visually-hidden">items in cart</span>
                            </span>
                        }
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="site-footer-divider"></div>
    <footer class="site-footer">
        <div class="container py-5" style="max-width: 80rem;">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <h5 class="site-footer__brand">KANIMECLOTHING</h5>
                    <p class="site-footer__description">Your ultimate destination for anime-inspired fashion. Discover unique designs that bring your favorite characters to life.</p>
                    <div class="site-footer__social-links">
                        <a href="#" class="site-footer__social-link" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="site-footer__social-link" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="site-footer__social-link" title="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="site-footer__social-link" title="TikTok"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="site-footer__heading">Quick Links</h6>
                    <ul class="site-footer__nav-list list-unstyled">
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="Categories">Categories</a></li>
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="Shop">Shop</a></li>
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="site-footer__heading">Customer Service</h6>
                    <ul class="site-footer__nav-list list-unstyled">
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="">Size Guide</a></li>
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="">Shipping Info</a></li>
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="">Returns & Exchanges</a></li>
                        <li><a class="site-footer__nav-link" asp-area="" asp-controller="Home" asp-action="">FAQ</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="site-footer__heading">Stay Updated</h6>
                    <p class="site-footer__description">Subscribe to get special offers and new arrivals!</p>
                    <div class="site-footer__newsletter">
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="Enter your email" aria-label="Email address">
                            <button class="btn btn-dark" type="button">Subscribe</button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="site-footer__heading">Contact Us</h6>
                    <ul class="site-footer__contact-list list-unstyled">
                        <li class="site-footer__contact-item">support@kanimeclothing.com</li>
                        <li class="site-footer__contact-item"><i class="fas fa-phone"></i>+27 (000) 000-000</li>
                    </ul>
                </div>
            </div>

            <hr class="my-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="site-footer__copyright">&copy; 2026 KANIMECLOTHING. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="site-footer__legal-link">Privacy Policy</a>
                    <a href="#" class="site-footer__legal-link">Terms of Service</a>
                    <a href="#" class="site-footer__legal-link">Cookie Policy</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
