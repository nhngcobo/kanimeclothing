@using kanimeclothing.Services
@using kanimeclothing.Models
@inject ILocalizationService Localizer
@model Product

@{
    ViewData["Title"] = Model?.Name ?? "Product Details";
}

<link rel="stylesheet" href="~/css/details.css" />
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

<div class="details-container">
    <div class="details-back-link">
        <a href="@Url.Action("Shop", "Home")" class="back-link">← @Localizer["BackToShop"]</a>
    </div>

    @if (Model != null)
    {
        <div class="details-wrapper">
            <div class="details-image-section">
                <div class="details-image-container" id="imageContainer">
                    <img src="@Model.Url" alt="@Model.Name" class="details-product-image" id="productImage">
                    <div class="details-magnifier" id="magnifier">
                        <div class="details-magnifier-glass" id="magnifierGlass"></div>
                    </div>
                    @if (Model.Id == 1)
                    {
                        <div class="details-badge">SALE</div>
                    }
                </div>
            </div>

            <div class="details-info-section">
                <h1 class="details-title">@Model.Name</h1>

                <div class="details-category-rating">
                    <p class="details-category">@Model.Category</p>
                </div>

                <div class="details-price-section">
                    <p class="details-price">R@(Model.Price.ToString("F2"))</p>
                    <p class="details-stock">
                        @if (Model.Stock > 0)
                        {
                            <span class="stock-available">@Localizer["InStock"] (@Model.Stock @Localizer["Items"])</span>
                        }
                        else
                        {
                            <span class="stock-unavailable">@Localizer["OutOfStock"]</span>
                        }
                    </p>
                </div>

                <div class="details-section">
                    <h3 class="section-title">@Localizer["ProductDetails"]</h3>
                    
                    <div class="details-options">
                        <div class="option-group">
                            <label class="option-label">@Localizer["Size"]:</label>
                            <div class="size-options">
                                <button type="button" class="size-btn" data-size="S">@Localizer["S"]</button>
                                <button type="button" class="size-btn" data-size="M">@Localizer["M"]</button>
                                <button type="button" class="size-btn" data-size="L">@Localizer["L"]</button>
                                <button type="button" class="size-btn" data-size="XL">@Localizer["XL"]</button>
                            </div>
                        </div>
                        
                        <div class="option-group">
                            <label for="colorSelect" class="option-label">@Localizer["Color"]:</label>
                            <select id="colorSelect" class="option-select">
                                <option value="">@Localizer["SelectColor"]</option>
                                <option value="Black" selected="@(Model.Color == "Black")">@Localizer["Black"]</option>
                                <option value="White" selected="@(Model.Color == "White")">@Localizer["White"]</option>
                                <option value="Grey" selected="@(Model.Color == "Grey")">@Localizer["Grey"]</option>
                            </select>
                        </div>
                    </div>
                    
                    <table class="details-table">
                        <tr>
                            <td class="label">@Localizer["Material"]:</td>
                            <td class="value">@Model.Material</td>
                        </tr>
                        <tr>
                            <td class="label">@Localizer["Measurements"]:</td>
                            <td class="value">@Model.Measurements</td>
                        </tr>
                        <tr>
                            <td class="label">@Localizer["Origin"]:</td>
                            <td class="value">@Model.Origin</td>
                        </tr>
                        <tr>
                            <td class="label">@Localizer["Barcode"]:</td>
                            <td class="value">
                                <svg id="barcode"></svg>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="details-actions">
                    <form method="post" asp-action="AddToCart" class="add-to-cart-form">
                        <input type="hidden" name="productId" value="@Model.Id">
                        <input type="hidden" name="size" id="selectedSize">
                        <input type="hidden" name="color" id="selectedColor">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="add-to-cart-btn" @(Model.Stock <= 0 ? "disabled" : "")>
                            @if (Model.Stock > 0)
                            {
                                <span>@Localizer["AddToCart"]</span>
                            }
                            else
                            {
                                <span>@Localizer["OutOfStock"]</span>
                            }
                        </button>
                    </form>
                </div>

                <div class="details-share">
                    <p class="share-title">@Localizer["ShareThisProduct"]:</p>
                    <div class="share-buttons">
                        <button class="share-btn facebook" title="Share on Facebook"><i class="bi bi-facebook"></i></button>
                        <button class="share-btn twitter" title="Share on Twitter"><i class="bi bi-twitter-x"></i></button>
                        <button class="share-btn email" title="Share via Email"><i class="bi bi-envelope"></i></button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="product-not-found">
            <p>Product not found.</p>
            <a href="@Url.Action("Shop", "Home")" class="back-link">Go back to shop</a>
        </div>
    }

    @if (ViewBag.ProductReviews != null && ViewBag.ProductReviews.Count > 0)
    {
        <div class="reviews-section">
            <h2 class="reviews-title">Customer Reviews</h2>
            <div class="reviews-container">
                @foreach (var review in ViewBag.ProductReviews)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <h3 class="review-author">@review.ReviewerName</h3>
                            <div class="review-rating">
                                @for (int i = 0; i < 5; i++)
                                {
                                    if (i < review.Rating)
                                    {
                                        <span class="star filled">★</span>
                                    }
                                    else
                                    {
                                        <span class="star">☆</span>
                                    }
                                }
                            </div>
                        </div>
                        <p class="review-text">@review.ReviewText</p>
                        <p class="review-date">@review.CreatedDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (ViewBag.RelatedProducts != null && ViewBag.RelatedProducts.Count > 0)
    {
        <div class="related-products-section">
            <h2 class="related-title">You might also like</h2>
            <div class="related-products-grid">
                @foreach (var relatedProduct in ViewBag.RelatedProducts)
                {
                    <a asp-action="Details" asp-controller="Home" asp-route-id="@relatedProduct.Id" class="related-product-card">
                        <div class="related-product-image-container">
                            <img src="@relatedProduct.Url" alt="@relatedProduct.Name" class="related-product-image">
                            @if (relatedProduct.Id == 1)
                            {
                                <div class="related-product-badge">SALE</div>
                            }
                        </div>
                        <div class="related-product-info">
                            <h3 class="related-product-name">@relatedProduct.Name</h3>
                            <p class="related-product-brand">@relatedProduct.Category</p>
                            <p class="related-product-price">R@(relatedProduct.Price.ToString("F2"))</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>

<script>

document.addEventListener('DOMContentLoaded', function() {
    // Initialize size buttons
    const sizeButtons = document.querySelectorAll('.size-btn');
    sizeButtons.forEach(button => {
        if (button.dataset.selected === 'True') {
            button.classList.add('selected');
        }
        
        button.addEventListener('click', function() {
            sizeButtons.forEach(btn => btn.classList.remove('selected'));
            this.classList.add('selected');
            document.getElementById('selectedSize').value = this.dataset.size;
        });
    });

    // Initialize color selector
    const colorSelect = document.getElementById('colorSelect');
    if (colorSelect) {
        colorSelect.addEventListener('change', function() {
            document.getElementById('selectedColor').value = this.value;
        });
        // Set initial color
        if (colorSelect.value) {
            document.getElementById('selectedColor').value = colorSelect.value;
        }
    }

    // Generate barcode
    // Initialize barcode if available
    const barcodeValue = '@Model?.Barcode';
    if (barcodeValue && typeof JsBarcode !== 'undefined') {
        JsBarcode("#barcode", barcodeValue, {
            format: "CODE128",
            width: 2,
            height: 50,
            displayValue: true,
            fontSize: 12
        });
    }
    // Image magnifier functionality
    const imageContainer = document.getElementById('imageContainer');
    const productImage = document.getElementById('productImage');
    const magnifier = document.getElementById('magnifier');
    const magnifierGlass = document.getElementById('magnifierGlass');
    
    if (!imageContainer || !productImage || !magnifier || !magnifierGlass) return;
    
    const zoomLevel = 3;
    const magnifierSize = 200;
    const radius = magnifierSize / 2;
    
    imageContainer.addEventListener('mouseenter', function() {
        magnifier.classList.add('active');
    });
    
    imageContainer.addEventListener('mouseleave', function() {
        magnifier.classList.remove('active');
    });
    
    imageContainer.addEventListener('mousemove', function(e) {
        if (!magnifier.classList.contains('active')) return;
        
        const rect = imageContainer.getBoundingClientRect();
        let x = e.clientX - rect.left;
        let y = e.clientY - rect.top;
        
        // Keep magnifier within bounds
        x = Math.max(radius, Math.min(x, rect.width - radius));
        y = Math.max(radius, Math.min(y, rect.height - radius));
        
        // Position magnifier centered on cursor
        magnifier.style.left = x + 'px';
        magnifier.style.top = y + 'px';
        
        // Update magnifier glass background
        magnifierGlass.style.backgroundImage = 'url(' + productImage.src + ')';
        magnifierGlass.style.backgroundSize = (rect.width * zoomLevel) + 'px ' + (rect.height * zoomLevel) + 'px';
        
        // Calculate proper background position
        const bgPosX = -(x * zoomLevel - radius);
        const bgPosY = -(y * zoomLevel - radius);
        
        magnifierGlass.style.backgroundPosition = bgPosX + 'px ' + bgPosY + 'px';
    });
});
</script>
